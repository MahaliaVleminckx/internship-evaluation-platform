@model StudentCompetencesViewModel
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-success" style="padding:10px; border-radius:5px; margin-bottom:20px; background-color:#d4edda; color:#155724; border:1px solid #c3e6cb;">
        @TempData["SuccessMessage"]
        @if (Model.IsReadOnly)
        {
            <div style="padding:10px; border-radius:5px; margin-bottom:20px; background-color:#e2f0ff; color:#0c5460; border:1px solid #bee5eb;">
                Je evaluatie is ingevuld en wordt hieronder weergegeven.
            </div>
        }
    </div>
}

<form asp-controller="Student" asp-action="SubmitCompetenceEvaluation" method="post">

    <input type="hidden" asp-for="EvaluationId" />
    <input type="hidden" asp-for="DomainId" />

    <!-- HEADER -->
    <div class="evaluation-title-box" style="display:flex; align-items:center; gap:20px; margin-bottom:20px;">

        <a asp-controller="Evaluations" asp-action="Index" asp-route-username="test@test.com" class="custom-btn">
            ←
        </a>

        <div style="display:flex; align-items:baseline; gap:10px;">
            <h1 style="margin:0;">@Model.Title</h1>
            <span class="evaluation-subtitle">(@Model.DomainName)</span>
        </div>
    </div>

    <!-- COMPETENCES -->
    @for (int i = 0; i < Model.Competences.Count; i++)
    {
        var competence = Model.Competences[i];

        <div class="competence-box" style="box-shadow: 0 2px 5px rgb(185 180 182); padding:15px; margin-bottom:20px; border-radius:8px; background-color: #f8f8f8;">

            <p style="font-weight: 600;">
                @competence.Name: <small>@competence.Description</small>
            </p>

            <input type="hidden" asp-for="Competences[@i].Id" />

            @{
                var groupedIndicator = competence.Indicators
                    .OrderBy(i => i.ScaleValueScore)
                    .GroupBy(i =>
                        i.ScaleValueScore == 1 ? 1 :
                        i.ScaleValueScore <= 3 ? 2 :
                        i.ScaleValueScore <= 5 ? 3 : 4);
            }

            <div class="indicators-group" style="display:flex; justify-content:center; gap:20px; margin-top:15px; flex-wrap:wrap;">

                @foreach (var group in groupedIndicator)
                {
                    <div style="flex:1; min-width:120px; text-align:center; margin-bottom:15px;">

                        <div style="display: flex; justify-content:center; gap: 20px;">
                            @foreach (var indicator in group)
                            {
                                <div style="display:flex; flex-direction: column; align-items: center;">

                                    <p style="font-size: 0.8rem;font-weight:700; margin:0;">
                                        @indicator.ScaleValue
                                    </p>

                                    <input type="radio"
                                           asp-for="Competences[@i].SelectedIndicatorId"
                                           value="@indicator.Id"
                                           class="answer-@indicator.ScaleValueScore"
                                           style="margin-top:20px; margin-bottom:10px;"
                                           style="margin-top:20px; margin-bottom:10px;"
                                           disabled="@(Model.IsReadOnly)">
                                </div>
                            }
                        </div>

                        <div class="text-muted" style="font-size: 0.8em;">
                            @group.First().Description
                        </div>
                    </div>
                }
            </div>

            <!-- NOT APPLICABLE -->
            <div style="margin-top:10px;">
                <input type="radio"
                       asp-for="Competences[@i].SelectedIndicatorId"
                       value=""
                       disabled="@(Model.IsReadOnly)" />
                <span class="text-muted" style="font-size:0.7em;">
                    Vraag is niet van toepassing
                </span>
            </div>

            <!-- COMMENT -->
            <div class="textarea-container">
                <label style="display:block; margin-bottom:5px;">
                    Extra toelichting
                </label>

                <textarea asp-for="Competences[@i].Comment"
                          class="form-control"
                          readonly="@(Model.IsReadOnly)"></textarea>
            </div>

        </div>
    }

    <!-- BUTTONS -->
    <div style="margin-top: 30px; display: flex; gap:15px;">
        @if (!Model.IsReadOnly)
        {
            <button class="custom-btn" type="submit">Evaluatie opslaan</button>
        }

        <a asp-controller="Evaluations"
           asp-action="ShowDomainsPerEvaluation"
           asp-route-evaluationId="@Model.EvaluationId"
           class="custom-btn-gobackdomains">
            Terug naar domeinen
        </a>
    </div>

</form>