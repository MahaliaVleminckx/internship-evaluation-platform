@model StudentEvaluationViewModel

<h2>Fill in Evaluation</h2>

<form asp-action="Fill" method="post">
    <input type="hidden" asp-for="EvaluationId" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        <div style="margin-bottom: 10px;">
            <label>@Model.Questions[i].QuestionText</label><br />

            <input asp-for="Questions[i].Answer" class="form-control" />

            <input type="hidden" asp-for="Questions[i].QuestionId" />
        </div>
    }

    <button type="submit" class="btn btn-primary">Save</button>
</form>