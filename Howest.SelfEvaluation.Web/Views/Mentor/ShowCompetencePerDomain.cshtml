@model MentorCompetencesViewModel

@if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success" style="padding:10px; border-radius:5px; margin-bottom:20px; background-color:#d4edda; color:#155724; border:1px solid #c3e6cb;">
                    @TempData["SuccessMessage"]
                </div>
            }

<form asp-action="SubmitCompetenceEvaluation" method="post">
    <input type="hidden" asp-for="EvaluationId" />
    <input type="hidden" asp-for="DomainId" />

    <div class="evaluation-title-box" style="display:flex; align-items:center; gap:20px; margin-bottom:20px;">
        <a asp-controller="Mentor" asp-action="Index" class="custom-btn">
            ←
        </a>
        <div style="display:flex; align-items:baseline; gap:10px;">
            <h1 style="margin:0;">@Model.Title</h1>
            <span class="evaluation-subtitle">(@Model.DomainName)</span>
        </div>
    </div>

    @for (int i = 0; i < Model.Competences.Count; i++)
    {
        var competence = Model.Competences[i];
        <div class="competence-box" style="box-shadow: 0 2px 5px rgb(185 180 182); padding:15px; margin-bottom:20px; border-radius:8px; background-color: #f8f8f8;">

            <p style="font-weight: 600;">@competence.Name: <small>@competence.Description</small></p>

            <input type="hidden" asp-for="Competences[@i].Id" />

            @{
                var groupedIndicator = competence.Indicators.OrderBy(i => i.ScaleValueScore)
                    .GroupBy(i => i.ScaleValueScore == 1 ? 1 :
                i.ScaleValueScore <= 3 ? 2 :
                i.ScaleValueScore <= 5 ? 3 : 4);
            }

            <div class="indicators-group" style="display:flex; justify-content:center; gap:20px; margin-top:15px; flex-wrap:wrap;">
                @foreach (var group in groupedIndicator)
                {
                    <div class="indicators-group" style="flex:1; min-width:120px; text-align:center; margin-bottom:15px;">
                        <div style="display: flex; justify-content:center; gap: 20px;">
                            @foreach (var indicator in group)
                            {
                                <div class="indicator-option" style="display:flex; flex-direction: column; align-items: center;">
                                    <p style="font-size: 0.8rem;font-weight:700; margin:0;">@indicator.ScaleValue</p>
                                    <input type="radio" asp-for="Competences[@i].SelectedIndicatorId" value="@indicator.Id" class="answer-@indicator.ScaleValueScore" style="margin-top:20px; margin-bottom:10px;" />
                                </div>
                            }
                        </div>

                        <div class="text-muted" style="font-size: 0.8em;">
                            @group.First().Description
                        </div>
                    </div>
                }

            </div>

            <div style="margin-top:10px;">
                <input type="radio"
                       asp-for="Competences[@i].SelectedIndicatorId"
                       value="" />
                <span class="text-muted" style="font-size:0.7em;">
                    Vraag is niet van toepassing
                </span>
            </div>

            <div class="textarea-container">
                <textarea asp-for="Competences[@i].Comment" class="form-control" placeholder=" " @*required*@></textarea>
                <label>Extra toelichting</label>
            </div>
        </div>
    }



    <div style="margin-top: 30px; display: flex; gap:15px;">
        <button class="custom-btn" type="submit" name="action" value="save">Evaluatie opslaan</button>
        <a asp-controller="Mentor" asp-action="ShowDomainsPerEvaluation" asp-route-evaluationId="@Model.EvaluationId">
            <button class="custom-btn-gobackdomains" type="button">Terug naar domeinen</button>
        </a>
    </div>
</form>
