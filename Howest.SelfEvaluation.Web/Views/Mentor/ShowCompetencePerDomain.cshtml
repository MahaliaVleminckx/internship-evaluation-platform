@model MentorCompetencesViewModel

<div class="evaluation-title-box" style="display:flex; align-items:center; gap:20px;">
    <a asp-controller="Mentor" asp-action="Index" class="custom-btn">
        ←
    </a>
    <h1>@Model.Title</h1>
    <p><sub>(@Model.DomainName)</sub></p>
</div>

<div>
    @foreach (var competence in Model.Competences)
    {
        <div class="competence-box" style="box-shadow: 0 2px 5px rgb(185 180 182); padding:15px; margin-bottom:20px; border-radius:8px;">

        </div>
    }
</div>
