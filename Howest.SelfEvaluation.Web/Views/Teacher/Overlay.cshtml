@using Howest.SelfEvaluation.Web.ViewModels.Teacher
@model EvaluationOverlayViewModel

<h1>Evaluation Overlay</h1>
@foreach (var competence in Model.OverlayCompetences)
{
    <div class="competence-box">
        <h3>@competence.Name</h3>
        <p>@competence.Description</p>
        <hr />
        <div>
            <strong>Student Score:</strong>
            @competence.StudentScore
        </div>
        <div>
            <strong>Mentor Score:</strong>
            @competence.MentorScore
        </div>
        <br />
        <div>
            <strong>Student Comment:</strong>
            @competence.StudentComment
        </div>

        <div>
            <strong>Mentor Comment:</strong>
            @competence.MentorComment
        </div>
    </div>
}
