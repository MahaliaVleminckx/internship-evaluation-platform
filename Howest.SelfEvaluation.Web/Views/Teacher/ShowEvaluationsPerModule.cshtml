@model TeacherShowEvaluationsPerModuleViewModel

@{
    var rnd = new Random();
}

<div class="evaluation-title-box">
    @* TODO: once login system: redirect to Teacher/Modules *@
    <a asp-controller="Home" asp-action="Index" class="btn custom-btn">
        ←
    </a>
    <h1>Evaluaties</h1>
</div>

<div style="display:flex">
    @if (Model.Evaluations.Count() == 0)
    {
        <h4 style="margin-top: 10px;">Geen evaluaties werden gevonden.</h4>
    }
    @foreach (var evaluation in Model.Evaluations)
    {
        <div class="card module-box">
            @* TODO: awaiting for Microsoft Identity login system. Maybe use the same controller and action but give userId (with a check in the method on which role
                the user has) as route paramater?
                this to avoid code duplicity across classes? *@
            <a asp-controller="Teacher" asp-action="ShowDomainsPerEvaluation" asp-route-evaluationId="@evaluation.Id"
               asp-route-teacherId="" class="link-restyle">
                <div class="title-box gradient-@rnd.Next(1, 16) text-center">
                    <h4>@evaluation.Title</h4>
                </div>
                <div class="domain-box">
                    <h7 class="text-muted">Beschikbaar tot: @evaluation.EndDate.Value.ToString("d")</h7>
                </div>
            </a>
        </div>

    }
    <div class="card module-box">
        <a asp-controller="Teacher" asp-action="OverlaySelector" class="link-restyle">
            <div class="title-box gradient-@rnd.Next(1, 16) text-center">
                <h4>Overlay</h4>
            </div>
            <div class="domain-box">
                <h7 class="text-muted">Bekijk evaluaties in overlay modus</h7>
            </div>
        </a>
    </div>
</div>