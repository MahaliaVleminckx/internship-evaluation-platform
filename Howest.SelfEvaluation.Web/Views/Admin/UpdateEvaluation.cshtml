@model AdminUpdateEvaluationViewModel
<h1 class="mb-4">Evaluatie aanmaken</h1>

<div class="shadow-sm p-5 mb-4 rounded">
    <form asp-controller="Admin" asp-action="CreateEvaluation" method="post">
        <div class="mb-3">
            <label asp-for="@Model.Title" class="form-label"></label>
            <input asp-for="@Model.Title" class="form-control" />
            <span asp-validation-for="@Model.Title" class="text-danger"></span>

        </div>

        <div class="mb-3">
            <label asp-for="@Model.Description" class="form-label"></label>
            <textarea asp-for="@Model.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="@Model.Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="@Model.StartDate" class="form-label"></label>
            <input asp-for="@Model.StartDate" class="form-control" rows="3" />
            <span asp-validation-for="@Model.StartDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="@Model.EndDate" class="form-label"></label>
            <input asp-for="@Model.EndDate" class="form-control" rows="3" />
            <span asp-validation-for="@Model.EndDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="@Model.ModuleId" class="form-label"></label>
            <select asp-for="@Model.ModuleId" asp-items="@Model.Modules" class="form-select"></select>
        </div>

        <div class="form-group">
            <label>Competentie domeinen:</label>

            @for (int i = 0; i < Model.CompetenceDomains.Count(); i++)
            {
                <div>
                    <input asp-for="@Model.CompetenceDomains[i].IsSelected" class="form-check-inline" />
                    <label>@Model.CompetenceDomains[i].Text</label>
                    <input asp-for="@Model.CompetenceDomains[i].Value" />
                    <input asp-for="@Model.CompetenceDomains[i].Text" />
                </div>
            }
        
            <div>
                <label>@Model.IsPublished.Text</label>
                <input asp-for="@Model.IsPublished.IsSelected" class="form-check-inline" />
                <input asp-for="@Model.IsPublished.Value" />
                <input asp-for="@Model.IsPublished.Text" />
            </div>


            <button type="submit" class="custom-btn">Evaluatie aanmaken</button>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn custom-btn-gobackdomains">Annuleren</a>
        </form>
    </div>
