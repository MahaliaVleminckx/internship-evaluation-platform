@model AdminCreateEvaluationViewmodel
<div class="evaluation-title-box mt-4">
    <a asp-controller="Admin" asp-action="ShowAllEvaluations" class="btn custom-btn">
        ←
    </a>
    <h1>Evaluatie aanmaken</h1>
</div>

<div class="shadow-sm p-5 mb-4 rounded">
    <form asp-controller="Admin" asp-action="CreateEvaluation" method="post">

        <partial name="_EvaluationFormPartial" model="@Model" />
        <button type="submit" class="custom-btn">Evaluatie opslaan</button>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn custom-btn-gobackdomains">Annuleren</a>
    </form>
</div>
