@{ViewData["Title"] = "Create Module"; }

<h1 class="mb-4">Create Module</h1>

<div class="shadow-sm p-5 mb-4 rounded">
    <form asp-action="CreateModule" method="post">
        <div class="mb-3">
            <label for="name" class="form-label">Naam</label>
            <input type="text" class="form-control" name="name" placeholder="Geef modulenaam" required />
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Beschrijving</label>
            <textarea class="form-control" id="description" name="description" rows="3" placeholder="Modulebeschrijving"></textarea>
        </div>

        <div class="mb-3">
            <label for="ownerId" class="form-label">Teacher</label>
            <select class="form-select" id="ownerId" name="ownerId" required>
                <option value="">-- Kies teacher --</option>
                @foreach (var teacher in ViewBag.Teachers)
                {
                        <option value="@teacher.Id">@teacher.Username</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Studenten toewijzen</label>
            <div class="border p-2 rounded" style="max-height:200px; overflow-y:auto;">
                @foreach (var student in ViewBag.Students)
                {
                    <div class="form-check">
                       <input class="form-check-input" type="checkbox" name="assignedStudentIds" value="@student.Id" id="student-@student.Id" />
                       <label class="form-check-label" for="student-@student.Id">@student.Username</label>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="custom-btn">Create Module</button>
        <a href="/" class="btn custom-btn-gobackdomains">Cancel</a>
    </form>
</div>
