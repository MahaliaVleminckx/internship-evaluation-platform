@{ViewData["Title"] = "Login";
}

<div class="login-page container mt-5">
    <h2 class="mb-4 text-center">Log in</h2>

    <form class="mx-auto" style="max-width: 400px;">
        <div class="form-group mb-3">
            <label>Gebruikersnaam</label>
            <div class="input-group input-group-sm">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fas fa-user"></i>
                    </span>
                </div>
                <input type="text" class="form-control form-control-sm" placeholder="Voornaam.Achternaam@student.howest.be" />
            </div>

        </div>

        <div class="form-group mb-4">
            <label>Wachtwoord</label>
            <div class="input-group input-group-sm">
                <div class="input-group-prepend">
                    <span class="input-group-text">
                        <i class="fas fa-lock"></i>
                    </span>
                </div>
                <input type="password" class="form-control form-control-sm" placeholder="Wachtwoord" />
            </div>

        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary custom-btn">LOG IN</button>
        </div>
        <div class="text-center mt-3">
            <a href="#" class="small">Eerste keer inloggen?</a>
        </div>
    </form>
</div>