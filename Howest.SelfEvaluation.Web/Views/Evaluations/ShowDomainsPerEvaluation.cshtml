@model EvaluationsShowDomainsPerEvaluationViewModel

@{
    var rnd = new Random();
}

<div class="evaluation-title-box">
    @* TODO: once login system: redirect to Evaluations/Evaluations method*@
    <a asp-controller="Home" asp-action="Index" class="btn custom-btn">
        ←
    </a>
    <h1>Domeinen</h1>
    <p class="evaluation-subtitle"><sub class="evaluation-subtitle">(@Model.Title)</sub></p>
</div>
<div style="display:flex; flex-wrap:wrap; gap:30px;">
    @foreach (var domain in Model.CompetenceDomains)
    {
        <div style="display:flex; flex-direction:column; align-items:center; gap:10px;">

            <div class="card module-box">
                <a asp-controller="Student"
                   asp-action="FillDomain"
                   asp-route-domainId="@domain.Id"
                   class="link-restyle">

                    <div class="title-box gradient-@rnd.Next(1, 16) text-center">
                        <h5>@domain.Name</h5>
                    </div>

                </a>
            </div>

            @if (Model.StudentEvaluationScores.Any(s =>
                    s.UserId == Model.UserId &&
                    s.Indicator != null &&
                    s.Indicator.Competence.CompetenceDomainId == domain.Id))
            {
                <a asp-controller="Student"
                   asp-action="ShowDomainResult"
                   asp-route-domainId="@domain.Id"
                   asp-route-userId="@Model.UserId"
                   class="btn custom-btn domain-btn">
                    Bekijk mijn antwoorden
                </a>
            }

        </div>
    }
</div>
@* TODO: chart page*@
<a asp-controller="Evaluations" asp-action="ShowCharts" asp-route-evaluationId="@Model.Id" class="btn custom-btn"
style="margin-top: 10px">
    Charts
</a>