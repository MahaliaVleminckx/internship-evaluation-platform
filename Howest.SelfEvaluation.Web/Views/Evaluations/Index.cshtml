@model EvaluationsIndexViewModel

@{
    var rnd = new Random();
}

<h1>Mijn modules</h1>

@foreach (var module in Model.Modules)
{
    <div class="card module-box">
        <a asp-controller="Evaluations" asp-action="ShowEvaluationsPerModule" asp-route-moduleId="@module.Id" asp-route-userId ="@Model.UserId" 
        class="link-restyle">
            <div class="title-box gradient-@rnd.Next(1,16) text-center">
                <h3>@module.Name</h3>
            </div>
            <div class="domain-box">
                <h6>@module.Description</h6>
                <h7 class="text-muted">Aantal evaluaties: @module.Evaluations.Count()</h7>
            </div>
        </a>
    </div>
}
