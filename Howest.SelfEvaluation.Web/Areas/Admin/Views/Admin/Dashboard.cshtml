<h1>Admin Dashboard</h1>

<div>
    <div class="mt-3 mb-3">
        <h5>Evaluaties</h5>
        <div>
            <a asp-area ="Admin" asp-controller="Admin" asp-action="CreateEvaluation">Evaluatie aanmaken</a>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Admin" asp-action="ShowAllEvaluations">Toon alle evaluaties</a>
        </div>
