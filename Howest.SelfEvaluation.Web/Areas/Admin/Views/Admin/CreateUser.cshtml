@model Howest.SelfEvaluation.Web.ViewModels.Admin.AdminCreateUsersViewModel
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gebruiker toevoegen</h2>

    <a asp-action="Users" class="btn custom-btn">
        ←
    </a>
    </div>

    <form asp-action="CreateUser" asp-controller="Admin" method="post">


        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Firstname" class="form-label"></label>
            <input asp-for="Firstname" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="Lastname" class="form-label"></label>
            <input asp-for="Lastname" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control"/>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" asp-items="Model.Roles" class="form-control">
            </select>
        </div>
        <br />
        <button type="submit" class="custom-btn px-3 py-2">Opslaan</button>
    </form>
