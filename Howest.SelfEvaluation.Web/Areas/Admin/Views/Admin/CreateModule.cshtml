@model  AdminCreateModuleViewModel
@{ViewData["Title"] = "Create Module"; }

<h1 class="mb-4">Create Module</h1>

<div class="shadow-sm p-5 mb-4 rounded">
    <form asp-area="Admin" asp-action="CreateModule" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Naam</label>
            <input asp-for="Name" class="form-control" placeholder="Geef modulenaam" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beschrijving</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Modulebeschrijving"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="OwnerId" class="form-label">Teacher</label>
            <select asp-for="OwnerId" class="form-select" required>
                <option value="">-- Kies teacher --</option>
                @foreach (var teacher in Model.Teachers)
                {
                    <option value="@teacher.Id">@teacher.Username</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Studenten toewijzen</label>
            <div class="border p-2 rounded" style="max-height:200px; overflow-y:auto;">
                @foreach (var student in Model.Students)
                {
                    <div class="form-check">
                       <input class="form-check-input" type="checkbox" name="AssignedStudentIds" value="@student.Id" id="student-@student.Id" />
                       <label class="form-check-label" for="student-@student.Id">@student.Username</label>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="custom-btn">Module aanmaken</button>
        <a href="/" class="btn custom-btn-gobackdomains">Annuleren</a>
    </form>
</div>
